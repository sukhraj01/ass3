      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Network graph saved to results/similarity_network.png\n",
      "\n",
      "Network statistics:\n",
      "  Nodes: 14\n",
      "  Edges: 41\n",
      "  Average degree: 5.86\n"
