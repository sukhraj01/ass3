      "       vidya-vichaar                                  vidya-vichaar           36              8       2881        25          0           3          2                15              12                3\n",
      "        vidya-vichar                                   vidya-vichar            1              0          3         0          0           0          0                 0               0                0\n",
      "vidya-vichar-iiith-s vidya-vichar-iiith-ssd-26-sep-25-mid-hackathon           65             22      11026        17         26           7          2                26               6                4\n",
      "             Team_25                            vidyavichara-team25           47             15      33309        17         20           2          1                20               4                4\n",
